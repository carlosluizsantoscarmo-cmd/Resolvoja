# Configuração do Cloudflare Pages. Só para o Caminho B (terminal). Renomeie para wrangler.toml e preencha o id do KV (passo 3 do LEIAME).
name = "resolvoja"
pages_build_output_dir = "./public"
compatibility_date = "2026-10-01"

[[kv_namespaces]]
binding = "LEADS"
id = "COLE_AQUI_O_ID_DO_KV"

[vars]
ALLOWED_ORIGINS = "https://www.resolvoja.app.br,https://resolvoja.app.br"
